{
  "name": "qa-mobile-appium",
  "version": "1.0.0",
  "description": "Automação mobile com Appium + WebdriverIO no native-demo-app — desafio QA Automation",
  "private": true,
  "scripts": {
    "preparar:android": "npm ci && node scripts/baixar-app.js --android-only && node scripts/criar-emulador-projeto.js",
    "preparar:ios": "npm ci && node scripts/baixar-app.js --ios-only",
    "preparar": "npm run preparar:android",
    "baixar:app": "node scripts/baixar-app.js",
    "baixar:app:android": "node scripts/baixar-app.js --android-only",
    "baixar:app:ios": "node scripts/baixar-app.js --ios-only",
    "emulador:criar": "node scripts/criar-emulador-projeto.js",
    "emulador:iniciar": "node scripts/iniciar-emulador-projeto.js",
    "emulador:iniciar:headless": "node scripts/iniciar-emulador-projeto.js --headless",
    "testar:android:local": "node scripts/rodar-suite-local.js",
    "testar:android:smoke": "node scripts/rodar-suite-local.js --smoke",
    "testar:android:local:wdio": "wdio run wdio.android.local.conf.js",
    "testar:android:login": "wdio run wdio.android.local.conf.js --spec ./testes/login.spec.js",
    "testar:android:cadastro": "wdio run wdio.android.local.conf.js --spec ./testes/cadastro.spec.js",
    "testar:android:formularios": "wdio run wdio.android.local.conf.js --spec ./testes/formularios.spec.js",
    "testar:android:navegacao": "wdio run wdio.android.local.conf.js --spec ./testes/navegacao.spec.js",
    "testar:android:erros": "wdio run wdio.android.local.conf.js --spec ./testes/erros.spec.js",
    "testar:android:bs": "wdio run wdio.android.browserstack.conf.js",
    "testar:android:bs:smoke": "wdio run wdio.android.browserstack.conf.js --mochaOpts.grep @smoke",
    "testar:android:bs:login": "wdio run wdio.android.browserstack.conf.js --spec ./testes/login.spec.js",
    "testar:ios:local": "node scripts/rodar-suite-local.js --ios",
    "testar:ios:smoke": "node scripts/rodar-suite-local.js --ios --smoke",
    "testar:ios:local:wdio": "wdio run wdio.ios.local.conf.js",
    "testar:ios:login": "wdio run wdio.ios.local.conf.js --spec ./testes/login.spec.js",
    "testar:ios:bs": "wdio run wdio.ios.browserstack.conf.js",
    "testar:ios:bs:smoke": "wdio run wdio.ios.browserstack.conf.js --mochaOpts.grep @smoke",
    "verificar:ci": "node scripts/verificar-ci.js",
    "relatorio:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "mobile",
    "qa",
    "automacao"
  ],
  "author": "Joab Cruz",
  "license": "MIT",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.4.0",
    "@wdio/appium-service": "^9.4.0",
    "@wdio/cli": "^9.4.0",
    "@wdio/local-runner": "^9.4.0",
    "@wdio/mocha-framework": "^9.4.0",
    "@wdio/spec-reporter": "^9.4.0",
    "allure-commandline": "^2.32.0",
    "appium": "^2.12.1",
    "appium-uiautomator2-driver": "^3.9.0",
    "chai": "^4.5.0",
    "webdriverio": "^9.4.0"
  }
}
